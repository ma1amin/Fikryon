{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api-server": {
      "root": "artifacts/api-server",
      "framework": "express",
      "installCommand": "corepack pnpm install --frozen-lockfile",
      "entrypoint": "src/app.ts",
      "buildCommand": "pnpm run build",
      "devCommand": "pnpm run dev",
      "functions": { "src/app.ts": { "maxDuration": 60 } }
    },
    "fikryon-coming-soon": {
      "root": "artifacts/fikryon-coming-soon",
      "framework": "vite",
      "installCommand": "corepack pnpm install --frozen-lockfile",
      "buildCommand": "pnpm run build",
      "outputDirectory": "dist/public",
      "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
    },
    "mockup-sandbox": {
      "root": "artifacts/mockup-sandbox",
      "framework": "vite",
      "installCommand": "corepack pnpm install --frozen-lockfile",
      "buildCommand": "pnpm run build",
      "outputDirectory": "dist",
      "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
    }
  },
  "crons": [{ "path": "/api/cron/email-delivery", "schedule": "0 21 * * *" }],
  "rewrites": [
    { "source": "/api", "destination": { "service": "api-server" } },
    { "source": "/api/(.*)", "destination": { "service": "api-server" } },
    { "source": "/(.*)", "destination": { "service": "fikryon-coming-soon" } }
  ]
}
